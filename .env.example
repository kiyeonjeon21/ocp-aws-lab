# cp .env.example .env 후 값을 채우세요. .env는 gitignore 됩니다.

# --- AWS ---
# 이 실습 전용 IAM 유저 프로파일. 다른 프로젝트 키와 섞지 마세요.
AWS_PROFILE=ocp-lab

# 리전은 무엇을 연습하느냐에 따라 다릅니다. README의 "리전 선택" 절 참고.
#   us-east-1        설치/삭제 반복 연습. CLI 위주라 지연이 안 느껴지고 20% 쌉니다
#   ap-northeast-2   콘솔/RHOAI 대시보드/워크벤치를 오래 만질 때 (서울 기준 RTT 30ms vs 199ms)
REGION=us-east-1

# 단일 AZ 고정. NAT Gateway를 3개에서 1개로 줄이는 핵심 설정입니다.
# 해당 AZ에 인스턴스 재고가 없으면(InsufficientInstanceCapacity) b, c 등으로 바꾸세요.
#
# GPU를 쓸 거라면 그 AZ에 g6가 있는지 먼저 확인하세요.
# ap-northeast-2b에는 g6가 없습니다. 단일 AZ로 깔기 때문에 설치 후에는 못 바꿉니다.
# preflight.sh가 ai 프로파일일 때 이걸 검사합니다.
AZ=us-east-1a

# --- 클러스터 ---
# baseDomain: 이 이름의 퍼블릭 호스팅 존이 Route 53에 미리 있어야 합니다.
# 보유 도메인의 서브도메인을 위임해 쓰는 걸 권합니다 (예: ocp.example.com).
BASE_DOMAIN=ocp.example.com

# 클러스터 이름. 짧게 유지하세요. 모든 FQDN에 들어갑니다.
#   api.${CLUSTER_NAME}.${BASE_DOMAIN}
#   *.apps.${CLUSTER_NAME}.${BASE_DOMAIN}
CLUSTER_NAME=lab1

# 기본 프로파일 (minimal | compact | sno | default | ai)
# ai = agent 스택 + Red Hat OpenShift AI 실습용 (워커 m6i.2xlarge x2)
PROFILE=minimal

# --- 태그 ---
# 모든 AWS 리소스에 붙습니다. Cost Explorer 필터와 정리 스크립트가 이걸 봅니다.
OWNER=your-name

# --- 비용 안전장치 ---
# setup-budget.sh 가 쓰는 값. Budgets 는 청구 지연 때문에 백스톱일 뿐입니다.
BUDGET_LIMIT=20
BUDGET_EMAIL=you@example.com

# --- 로컬 경로 ---
# 이 실습 전용 SSH 키. preflight.sh가 없으면 만들어줍니다.
SSH_KEY_PATH=~/.ssh/id_ocp_lab

# Red Hat pull secret 위치
PULL_SECRET_PATH=secrets/pull-secret.json

# --- agent 스택 / RHOAI (전부 선택. 비워두면 lib.sh의 기본값을 씁니다) ---
# 아래 값들은 ai 프로파일에서만 의미가 있습니다.
# 기본값으로 그냥 돌아가므로, 바꾸고 싶은 게 없으면 이 블록을 통째로 지워도 됩니다.

# 네임스페이스
# AGENT_NAMESPACE=agent-lab
# RHOAI_NAMESPACE=ai-serving

# 오프라인 스위치 일괄 토글.
#   false  인터넷 있는 클러스터의 기준선 (기본값)
#   true   ocp-airgap-lab과 같은 설정. 같은 클러스터에서 기동 지연 차이를 재려고 씁니다
# AGENT_OFFLINE=false

# PVC가 붙을 StorageClass. 비우면 클러스터의 기본값(AWS IPI는 gp3-csi)을 찾아 씁니다.
# STORAGE_CLASS=

# 컨테이너 이미지.
# ocp-airgap-lab은 같은 변수에 미러 레지스트리 경로를 넣습니다.
# 즉 두 레포의 manifests/**/*.yaml.tpl은 내용이 같아야 정상입니다.
# IMAGE_LLAMA=ghcr.io/ggml-org/llama.cpp:server
# IMAGE_LITELLM=ghcr.io/berriai/litellm:main-stable
# IMAGE_QDRANT=docker.io/qdrant/qdrant:v1.12.4
# IMAGE_OPENWEBUI=ghcr.io/open-webui/open-webui:main
# IMAGE_PHOENIX=docker.io/arizephoenix/phoenix:latest

# 모델. llama.cpp는 GGUF를, RHOAI의 vLLM은 HuggingFace 원본을 씁니다.
# MODEL_NAME=qwen2.5-1.5b
# MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
# MODEL_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct

# GPU 워커. 설치 후 gpu-node.sh로 붙였다 뗍니다.
# g6.xlarge = L4 24GB, us-east-1 기준 시간당 $0.80 (g5.xlarge보다 싸고 메모리는 같습니다)
# GPU_INSTANCE_TYPE=g6.xlarge
# GPU_VOLUME_SIZE=200
